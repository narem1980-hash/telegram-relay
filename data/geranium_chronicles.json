{"channel": "geranium_chronicles", "title": "Хроники Гераней", "posts": [{"id": "87180", "text": "19:50-20:05 Киев - взрывы💥Герани🚀", "datetime": "2026-09-27T17:08:09+00:00", "url": "https://t.me/geranium_chronicles/87180"}, {"id": "87181", "text": "Удар Герани в Голосеевском районе Киева.  Поражено административное здание.", "datetime": "2026-09-27T17:11:09+00:00", "url": "https://t.me/geranium_chronicles/87181"}, {"id": "87183", "text": "20:25 Киев - взрыв💥Герань🚀", "datetime": "2026-09-27T17:28:29+00:00", "url": "https://t.me/geranium_chronicles/87183"}, {"id": "87184", "text": "20:35 Киев - взрыв💥Герань🚀", "datetime": "2026-09-27T17:55:25+00:00", "url": "https://t.me/geranium_chronicles/87184"}, {"id": "87185", "text": "20:53 Харьковская область - взрывы💥УМПК. Бурлукский район.", "datetime": "2026-09-27T17:57:54+00:00", "url": "https://t.me/geranium_chronicles/87185"}, {"id": "87186", "text": "20:38 Измаил Одесской области - взрыв💥Герань🚀", "datetime": "2026-09-27T18:03:49+00:00", "url": "https://t.me/geranium_chronicles/87186"}, {"id": "87187", "text": "21:05 Киев - взрыв💥Герань🚀", "datetime": "2026-09-27T18:11:23+00:00", "url": "https://t.me/geranium_chronicles/87187"}, {"id": "87188", "text": "21:07 Кировоград - взрыв💥Герань🚀", "datetime": "2026-09-27T18:11:44+00:00", "url": "https://t.me/geranium_chronicles/87188"}, {"id": "87189", "text": "Тем временем в Киеве🤷‍♂", "datetime": "2026-09-27T18:14:47+00:00", "url": "https://t.me/geranium_chronicles/87189"}, {"id": "87190", "text": "Последствия вчерашнего удара в Херсоне🤔", "datetime": "2026-09-27T18:15:21+00:00", "url": "https://t.me/geranium_chronicles/87190"}, {"id": "87191", "text": "20:35 Киев - взрыв💥Герань🚀", "datetime": "2026-09-27T18:17:36+00:00", "url": "https://t.me/geranium_chronicles/87191"}, {"id": "87192", "text": "Вечерний Киев🚀", "datetime": "2026-09-27T18:26:57+00:00", "url": "https://t.me/geranium_chronicles/87192"}, {"id": "87193", "text": "И ещё вечерний Киев🤔", "datetime": "2026-09-27T18:2