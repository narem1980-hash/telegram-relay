anium_chronicles/96893"}, {"id": "96894", "text": "10:55 Донбасс и Запорожская область - взрывы💥УМПК.", "datetime": "2026-11-26T08:16:49+00:00", "url": "https://t.me/geranium_chronicles/96894"}, {"id": "96895", "text": "11:16 Кривой Рог - взрыв💥Герань🚀", "datetime": "2026-11-26T08:19:51+00:00", "url": "https://t.me/geranium_chronicles/96895"}, {"id": "96896", "text": "В Кривом Роге дым над местом ударов Гераней.", "datetime": "2026-11-26T08:22:21+00:00", "url": "https://t.me/geranium_chronicles/96896"}, {"id": "96897", "text": "11:20 Днепропетровская область - взрывы💥УМПК.", "datetime": "2026-11-26T08:22:24+00:00", "url": "https://t.me/geranium_chronicles/96897"}, {"id": "96898", "text": "Предварительно, утром ударом УМПК уничтожен мост на трассе, соединяющей города Александровка и Краматорск, в селе Михайловка.🍿", "datetime": "2026-11-26T08:33:09+00:00", "url": "https://t.me/geranium_chronicles/96898"}]}