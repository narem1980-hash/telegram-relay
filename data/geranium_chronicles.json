etime": "2026-10-07T01:34:30+00:00", "url": "https://t.me/geranium_chronicles/88691"}, {"id": "88692", "text": "04:23 Запорожье - взрывы💥УМПК.", "datetime": "2026-10-07T01:36:57+00:00", "url": "https://t.me/geranium_chronicles/88692"}, {"id": "88693", "text": "04:30 Электронная разведка (SIGINT) США фиксирует пуски крылатых ракет.❗️", "datetime": "2026-10-07T01:42:00+00:00", "url": "https://t.me/geranium_chronicles/88693"}, {"id": "88694", "text": "04:40 Первые Калибры❗️зафиксированы над Днепропетровской областью.", "datetime": "2026-10-07T01:42:48+00:00", "url": "https://t.me/geranium_chronicles/88694"}, {"id": "88695", "text": "04:45 Окрестности Днепропетровска - взрыв💥Калибр.", "datetime": "2026-10-07T01:48:39+00:00", "url": "https://t.me/geranium_chronicles/88695"}]}