es/83800"}, {"id": "83801", "text": "20:53 Староконстантинов Хмельницкой области - взрыв💥Герань🚀", "datetime": "2026-09-09T18:00:48+00:00", "url": "https://t.me/geranium_chronicles/83801"}, {"id": "83802", "text": "21:00 Харьков и Житомир - взрывы💥Герани🚀", "datetime": "2026-09-09T18:04:42+00:00", "url": "https://t.me/geranium_chronicles/83802"}, {"id": "83803", "text": "#НытьеПротивника«В течение следующего года Россия получит покрытие спутниковой связи над всей территорией Украины, и это приведёт к нашему поражению», — заявил командир 1-го отдельного штурмового полка \"Перун\".Отметим, что пресловутая система «Рассвет», которую Россия сейчас активно внедряет, призвана обеспечить широкополосную связь на фронте, объединить войска в единую сеть и дать возможность управлять ударными беспилотниками в режиме реального времени на большом расстоянии.🍿", "datetime": "2026-09-09T18:08:04+00:00", "url": "https://t.me/geranium_chronicles/83803"}]}