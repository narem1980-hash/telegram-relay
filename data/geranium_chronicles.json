{"channel": "geranium_chronicles", "title": "Хроники Гераней", "posts": [{"id": "83376", "text": "20:26 Борисполь - взрыв💥Герань🚀", "datetime": "2026-09-07T17:36:31+00:00", "url": "https://t.me/geranium_chronicles/83376"}, {"id": "83377", "text": "Под ударом мосты в Краматорске💥Летчики ВКС России нанесли удар полуторатонными фугасными авиабомбамипо мосту в Краматорске.✈️Курс на MAКС!", "datetime": "2026-09-07T18:02:34+00:00", "url": "https://t.me/geranium_chronicles/83377"}, {"id": "83378", "text": "Прилет Герани по \"Новой Почте\" вБроварах.", "datetime": "2026-09-07T18:08:55+00:00", "url": "https://t.me/geranium_chronicles/83378"}, {"id": "83379", "text": "21:10 Окрестности Василькова Киевской области - взрыв💥Герань🚀", "datetime": "2026-09-07T18:11:22+00:00", "url": "https://t.me/geranium_chronicles/83379"}, {"id": "83380", "text": "Тем временем в Умани... Наверное там для местных мужичков сейчас раздолье - надел кипу, приклеил пейсы и человеком себя на улице чувствуешь.😇", "datetime": "2026-09-07T18:20:28+00:00", "url": "https://t.me/geranium_chronicles/83380"}, {"id": "83381", "text": "21:10 Сумская область - взрывы💥УМПК.", "datetime": "2026-09-07T18:33:36+00:00", "url": "https://t.me/geranium_chronicles/83381"}, {"id": "83382", "text": "21:15 Днепропетровская область - взрывы💥УМПК.", "datetime": "2026-09-07T18:34:05+00:00", "url": "https://t.me/geranium_chronicles/83382"}, {"id": "83383", "text": "21:20 Донбасс  взрывы💥УМПК.", "datetime": "2026-09-07T18:34:37+00:00", "url": "https://t.me/geranium_chronicles/83383"}, {"id": "83384", "text": "21:27 Кривой Рог и Козелец Черниговской области - взрывы💥Герани🚀", "datetime": "2026-09-07T18:35:41+00:00", "url": "https://t.me/geranium_chronicles/83384"}, {"id": "83385", "text": "21:30 Запорожская область - взрывы💥УМПК.", "datetime": "2026-09-07T18:36:22+00:00", "url": "https://t.me/geranium_chronicles/83385"}, {"id": "83386", "text": "21:30 Противник фиксирует активность на боевых частотах стратегической авиации.⚠️", "datetime": "2026-09-07T18:38:10+00:00", "url": "https://t.me/geranium_chronicles/83386"}, {"id": "83387", "text": "21:38 Харьковской области - взрывы💥УМПК. Казачья Лопань.", "datetime": "2026-09-07T18:39:06+00:00", "url": "https://t.me/geranium_chronicles/83387"}, {"id": "83388", "text": "Прилет Герани по \"Новой Почте\" в  Броварах.", "datetime": "2026-09-07T18:43:40+00:00", "url": "https://t.me/geranium_chronicles/83388"}, {"id": "83390", "text": "Всем хорошего вечера понедельника!😇", "datetime": "2026-09-07T19:00:47+00:00", "url": "https://t.me/geranium_chronicles/83390"}, {"id": "83391", "text": "Всем Доброго утречка вторника!😇", "datetime": "2026-09-08T01:33:47+00:00", "url": "https://t.me/geranium_chronicles/83391"}, {"id": "83392", "text": "03:30 Бровары, Киев, Одесса и Белая Церковь - взрывы💥Баллистические ракеты.", "datetime": "2026-09-08T01:36:57+00:00", "url": "https://t.me/geranium_chronicles/83392"}, {"id": "83393", "text": "03:40-03:45 Киев - взрывы💥Искандер-М.", "datetime": "2026-09-08T01:38:00+00:00", "url": "https://t.me/geranium_chronicles/83393"}, {"id": "83394", "text": "04:07-04:15  Киев - взрывы💥Искандер-М.", "datetime": "2026-09-08T01:40:09+00:00", "url": "https://t.me/geranium_chronicles/83394"}, {"id": "83395", "text": "04:35 В воздухе над территорией противника примерно 20 Х-101 и заходят новые.❗️", "datetime": "2026-09-08T01:42:11+00:00", "url": "https://t.me/geranium_chronicles/83395"}]}