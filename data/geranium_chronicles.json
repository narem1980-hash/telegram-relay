{"channel": "geranium_chronicles", "title": "Хроники Гераней", "posts": [{"id": "89265", "text": "20:10 Окрестности Киева - взрыв💥Герань🚀", "datetime": "2026-10-09T17:13:51+00:00", "url": "https://t.me/geranium_chronicles/89265"}, {"id": "89266", "text": "19:50 Днепропетровск - взрыв💥Герань🚀", "datetime": "2026-10-09T17:16:56+00:00", "url": "https://t.me/geranium_chronicles/89266"}, {"id": "89267", "text": "Иранское видео о предке Геранек😇", "datetime": "2026-10-09T17:48:43+00:00", "url": "https://t.me/geranium_chronicles/89267"}, {"id": "89268", "text": "Испания и Греция отказались передавать Украине ракеты для Patriot, у которых истекает срок годности,сообщает издание The Telegraph.При этом у Греции около 200 таких ракет. И они будут просто утилизированы.😇", "datetime": "2026-10-09T17:49:32+00:00", "url": "https://t.me/geranium_chronicles/89268"}, {"id": "89269", "text": "20:40 Днепропетровск - взрыв💥Герань🚀", "datetime": "2026-10-09T17:50:54+00:00", "url": "https://t.me/geranium_chronicles/89269"}, {"id": "89270", "text": "Днепропетровск. Последствия ударов Гераней.", "datetime": "2026-10-09T17:56:42+00:00", "url": "https://t.me/geranium_chronicles/89270"}, {"id": "89272", "text": "Днепропетровск. Последствия ударов Гераней.", "datetime": "2026-10-09T17:59:59+00:00", "url": "https://t.me/geranium_chronicles/89272"}, {"id": "89273", "text": "20:58 Окрестности Сум - взрывы💥УМПК.", "datetime": "2026-10-09T18:02:18+00:00", "url": "https://t.me/geranium_chronicles/89273"}, {"id": "89274", "text": "20:59 Ильичёвск - взрыв💥Герань🚀", "datetime": "2026-10-09T18:05:43+00:00", "url": "https://t.me/geranium_chronicles/89274"}, {"id": "89275", "text": "20:59 Ильичёвск - взрыв💥Герань🚀", "datetime": "2026-10-09T18:07:00+00:00", "url": "https://t.me/geranium_chronicles/89275"}, {"id": "89276", "text": "В центре Одессы кратковременно пропали свет и вода.👀", "datetime": "2026-10-09T18:24:58+00:00", "url": "https://t.me/geranium_chronicles/89276"}, {"id": "89277", "text": "21:10 Окрестности Киева и Ивано-Франковск - взрывы💥Герани🚀", "datetime": "2026-10-09T18:26:05+00:00", "url": "https://t.me/geranium_chronicles/89277"}, {"id": "89278", "text": "21:25 Окрестности Киева - взрыв💥Герань🚀", "datetime": "2026-10-09T18:27:02+00:00", "url": "https://t.me/geranium_chronicles/89278"}, {"id": "89279", "text": "21:22 Харьковская область - взрывы💥УМПК.", "datetime": "2026-10-09T18:27:49+00:00", "url": "https://t.me/geranium_chronicles/89279"}, {"id": "89280", "text": "Вечерний Ивано-Франковск🤔", "datetime": "2026-10-09T18:29:33+00:00", "url": "https://t.me/geranium_chronicles/89280"}, {"id": "89282", "text": "21:10-21:20 Запорожская область - взрывы💥УМПК.", "datetime": "2026-10-09T18:59:36+00:00", "url": "https://t.me/geranium_chronicles/89282"}, {"id": "89283", "text": "Всем хорошего вечера пятницы!😇", "datetime": "2026-10-09T19:00:35+00:00", "url": "https://t.me/geranium_chronicles/89283"}, {"id": "89284", "text": "Всем Доброго субботнего утречка!😇", "datetime": "2026-10-10T02:06:11+00:00", "url": "https://t.me/geranium_chronicles/89284"}, {"id": "89285", "text": "Всю ночь гремело на западной Украине в Луцке, Ивано-Франковске, Староконстантинове.Основной фокус внимания Гераней🚀был на Луцке (на видео).Пока без деталей.🤔", "datetime": "2026-10-10T02:11:03+00:00", "url": "https://t.me/geranium_chronicles/89285"}]}