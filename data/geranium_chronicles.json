{"channel": "geranium_chronicles", "title": "Хроники Гераней", "posts": [{"id": "89372", "text": "12:10 Окрестности Сараты Одесской области - взрыв💥Герань🚀", "datetime": "2026-10-10T09:13:00+00:00", "url": "https://t.me/geranium_chronicles/89372"}, {"id": "89373", "text": "12:14-12:15 Окрестности Харькова - взрывы💥Торнадо-С.", "datetime": "2026-10-10T09:22:06+00:00", "url": "https://t.me/geranium_chronicles/89373"}, {"id": "89374", "text": "В Запорожской области за период с 07:30 09.10.2026 по 07:30 10.10.2026 нанесено не менее 14ти ударов УМПК, 1 удар РСЗО/ОТРК и как минимум 42 удара БПЛА Герань/Ланцет/Молния.", "datetime": "2026-10-10T09:26:43+00:00", "url": "https://t.me/geranium_chronicles/89374"}, {"id": "89375", "text": "12:10 Запорожская область - взрывы💥УМПК.", "datetime": "2026-10-10T09:30:36+00:00", "url": "https://t.me/geranium_chronicles/89375"}, {"id": "89376", "text": "12:22 Днепропетровская область - взрывы💥УМПК.", "datetime": "2026-10-10T09:31:02+00:00", "url": "https://t.me/geranium_chronicles/89376"}, {"id": "89377", "text": "12:25 Окрестности Харькова - взрыв💥Торнадо-С.", "datetime": "2026-10-10T09:31:11+00:00", "url": "https://t.me/geranium_chronicles/89377"}, {"id": "89378", "text": "12:25 Окрестности Харькова - взрыв💥Торнадо-С.", "datetime": "2026-10-10T09:47:36+00:00", "url": "https://t.me/geranium_chronicles/89378"}, {"id": "89379", "text": "Сегодня ночью Герани поразили железнодорожную инфраструктуру в окрестностях Коростеня Житомирской области.", "datetime": "2026-10-10T09:57:09+00:00", "url": "https://t.me/geranium_chronicles/89379"}, {"id": "89381", "text": "12:50 ПС 750 \"Киевская\" и окрестности Обухова Киевской области - взрывы💥Герани🚀", "datetime": "2026-10-10T09:59:18+00:00", "url": "https://t.me/geranium_chronicles/89381"}, {"id": "89382", "text": "В Соломенском районе Киева Герань поразила 8ми этажное офисное здание🧐", "datetime": "2026-10-10T10:04:21+00:00", "url": "https://t.me/geranium_chronicles/89382"}, {"id": "89383", "text": "❗️В Киеве не работает метро. В городе снова массово пропал свет.🕯Пупупу👀", "datetime": "2026-10-10T10:04:50+00:00", "url": "https://t.me/geranium_chronicles/89383"}, {"id": "89384", "text": "Некоторые станции метро сейчас🕯👀", "datetime": "2026-10-10T10:20:21+00:00", "url": "https://t.me/geranium_chronicles/89384"}, {"id": "89385", "text": "В Соломенском районе Киева Герань поразила 8ми этажное офисное здание🧐", "datetime": "2026-10-10T10:20:25+00:00", "url": "https://t.me/geranium_chronicles/89385"}, {"id": "89386", "text": "Из-за отсутствия напряжения в энергосистеме временно приостановлено движение части общественного транспорта в Соломенском, Печерском, частично Шевченковском и частично в Дарницком районах,— Киевпастранс.Под атакой подстанция 330 кВ «Новокиевская».", "datetime": "2026-10-10T10:22:07+00:00", "url": "https://t.me/geranium_chronicles/89386"}, {"id": "89387", "text": "Видео пораженного офиса в Киеве🧐", "datetime": "2026-10-10T10:29:46+00:00", "url": "https://t.me/geranium_chronicles/89387"}, {"id": "89389", "text": "13:20 Вознесенск Николаевской - взрыв💥Герань🚀", "datetime": "2026-10-10T10:57:37+00:00", "url": "https://t.me/geranium_chronicles/89389"}, {"id": "89390", "text": "14:00 Киев - взрывы💥ОТРК.", "datetime": "2026-10-10T11:04:55+00:00", "url": "https://t.me/geranium_chronicles/89390"}, {"id": "89391", "text": "14:09 Киев - взрыв💥ОТРК.", "datetime": "2026-10-10T11:10:33+00:00", "url": "https://t.me/geranium_chronicles/89391"}]}