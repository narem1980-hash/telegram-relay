ttps://t.me/geranium_chronicles/90689"}, {"id": "90692", "text": "Момент удара ракет с кассетной боевой частью в Харькове.", "datetime": "2026-10-17T19:37:26+00:00", "url": "https://t.me/geranium_chronicles/90692"}, {"id": "90695", "text": "22:25 Днепропетровск - взрыв💥Дань-Т.", "datetime": "2026-10-17T19:39:52+00:00", "url": "https://t.me/geranium_chronicles/90695"}, {"id": "90696", "text": "Всем Доброго воскресного утречка!😇", "datetime": "2026-10-18T02:32:37+00:00", "url": "https://t.me/geranium_chronicles/90696"}, {"id": "90697", "text": "Ночью Герани👻нанесли удары в районе Арциза Одесской области. В Измаильском, Болградском и Белгород-Днестровском районах возникли перебои с электроснабжением.👀Предварительно, нанесён удар по местной ПС 330/110/10 кВ «Арциз»🤔", "datetime": "2026-10-18T02:42:38+00:00", "url": "https://t.me/geranium_chronicles/90697"}]}