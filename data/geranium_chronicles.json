{"channel": "geranium_chronicles", "title": "Хроники Гераней", "posts": [{"id": "89120", "text": "21:45 Запорожская область - взрывы💥УМПК.", "datetime": "2026-10-08T18:47:42+00:00", "url": "https://t.me/geranium_chronicles/89120"}, {"id": "89121", "text": "21:50 Боярка Киевской области - взрыв💥Герань🚀", "datetime": "2026-10-08T18:55:45+00:00", "url": "https://t.me/geranium_chronicles/89121"}, {"id": "89122", "text": "Всем хорошего вечера четверга!😇", "datetime": "2026-10-08T19:03:28+00:00", "url": "https://t.me/geranium_chronicles/89122"}, {"id": "89123", "text": "22:02 Кривой Рог - взрыв💥Дань-Т.", "datetime": "2026-10-08T19:07:27+00:00", "url": "https://t.me/geranium_chronicles/89123"}, {"id": "89124", "text": "Идеальный план. Надёжный как швейцарские часы: \"Засрать Днепр\"©🍿", "datetime": "2026-10-08T19:49:50+00:00", "url": "https://t.me/geranium_chronicles/89124"}, {"id": "89125", "text": "Всем Доброго утречка пятницы!😇", "datetime": "2026-10-09T02:21:49+00:00", "url": "https://t.me/geranium_chronicles/89125"}, {"id": "89126", "text": "Ночью Герани🚀посетили Западную Украину. Под ударами были Ивано-Франковск, Луцк, Ягодин Волынской области и несколько ударов было в Ровенской области.На фото и видео Ивано-Франковск.", "datetime": "2026-10-09T02:26:24+00:00", "url": "https://t.me/geranium_chronicles/89126"}, {"id": "89130", "text": "Ещё видео из Ивано-Франковска🤔", "datetime": "2026-10-09T02:33:28+00:00", "url": "https://t.me/geranium_chronicles/89130"}, {"id": "89134", "text": "Также под ударами Гераней🚀были Киев и Киевская область.Под ударами Гераней был как сам город так и окрестности Вышгорода, Трипольской ТЭС и подстанции 750 кВ \"Киевская\".", "datetime": "2026-10-09T02:38:25+00:00", "url": "https://t.me/geranium_chronicles/89134"}, {"id": "89135", "text": "05:30-05:35 Запорожская область - взрывы💥УМПК.", "datetime": "2026-10-09T02:42:56+00:00", "url": "https://t.me/geranium_chronicles/89135"}, {"id": "89136", "text": "Третью ночь подряд ВКС наносят удары в районе мостов и по целям в  Запорожье.На месте одного из ударов в городе вспыхнул пожар.", "datetime": "2026-10-09T02:45:23+00:00", "url": "https://t.me/geranium_chronicles/89136"}, {"id": "89140", "text": "В Харькове, предварительно, ВКС нанесли удар УМПК по недавно заработавшейХарьковской ТЭЦ-5.", "datetime": "2026-10-09T02:51:58+00:00", "url": "https://t.me/geranium_chronicles/89140"}]}