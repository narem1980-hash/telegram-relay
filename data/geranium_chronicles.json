cles/91417"}, {"id": "91418", "text": "10:45 Степень Ровенской области - взрыв💥Герань🚀", "datetime": "2026-10-22T07:50:45+00:00", "url": "https://t.me/geranium_chronicles/91418"}, {"id": "91419", "text": "10:57 Днепропетровск - взрывы💥УМПК", "datetime": "2026-10-22T08:00:23+00:00", "url": "https://t.me/geranium_chronicles/91419"}, {"id": "91420", "text": "11:01 Днепропетровск - взрывы💥УМПК.", "datetime": "2026-10-22T08:03:41+00:00", "url": "https://t.me/geranium_chronicles/91420"}, {"id": "91421", "text": "Веселые Картинки от ППО😂210🚀(~350 за сутки) и 289 УМПК.", "datetime": "2026-10-22T08:09:38+00:00", "url": "https://t.me/geranium_chronicles/91421"}, {"id": "91422", "text": "11:03 Прилуки Черниговской области - взрыв💥Герань", "datetime": "2026-10-22T08:13:22+00:00", "url": "https://t.me/geranium_chronicles/91422"}, {"id": "91423", "text": "Движение транспорта по Южному мосту в Киеве временно перекрыто в обоих направлениях.🧐", "datetime": "2026-10-22T08:15:23+00:00", "url": "https://t.me/geranium_chronicles/91423"}, {"id": "91424", "text": "Днепропетровская суета🚀", "datetime": "2026-10-22T08:18:09+00:00", "url": "https://t.me/geranium_chronicles/91424"}, {"id": "91425", "text": "", "datetime": "2026-10-22T08:20:50+00:00", "url": "https://t.me/geranium_chronicles/91425"}, {"id": "91426", "text": "11:19 Окрестности Шостки Сумской области - взрывы💥Герани🚀", "datetime": "2026-10-22T08:23:50+00:00", "url": "https://t.me/geranium_chronicles/91426"}, {"id": "91427", "text": "11:20 Полтава и Днепропетровск - взрывы💥Дань-Т", "datetime": "2026-10-22T08:24:19+00:00", "url": "https://t.me/geranium_chronicles/91427"}, {"id": "91428", "text": "Утренняя Шостка Сумской области🧐", "datetime": "2026-10-22T08:25:00+00:00", "url": "https://t.me/geranium_chronicles/91428"}, {"id": "91429", "text": "11:30 Шепетовка Хмельницкой области - взрыв💥Герань🚀", "datetime": "2026-10-22T08:33:53+00:00", "url": "https://t.me/geranium_chronicles/91429"}]}