{"channel": "geranium_chronicles", "title": "Хроники Гераней", "posts": [{"id": "94875", "text": "19:05 Харьков - взрыв💥Герань🚀", "datetime": "2026-11-14T16:09:12+00:00", "url": "https://t.me/geranium_chronicles/94875"}, {"id": "94876", "text": "19:10 Сумская область - взрывы💥УМПК.", "datetime": "2026-11-14T16:25:27+00:00", "url": "https://t.me/geranium_chronicles/94876"}, {"id": "94877", "text": "19:27 Каменское Днепропетровской области - взрыв💥Герань🚀", "datetime": "2026-11-14T16:30:12+00:00", "url": "https://t.me/geranium_chronicles/94877"}, {"id": "94878", "text": "19:35 Окрестности Коростеня Житомирской области - взрыв💥Герань🚀", "datetime": "2026-11-14T17:02:21+00:00", "url": "https://t.me/geranium_chronicles/94878"}, {"id": "94879", "text": "19:40 Николаев - взрыв💥Герань🚀", "datetime": "2026-11-14T17:03:04+00:00", "url": "https://t.me/geranium_chronicles/94879"}, {"id": "94880", "text": "19:50 Новоград-Волынский - взрыв💥Герань🚀", "datetime": "2026-11-14T17:03:50+00:00", "url": "https://t.me/geranium_chronicles/94880"}, {"id": "94881", "text": "19:57 Бершадь Винницкой области - взрыв💥Герань🚀", "datetime": "2026-11-14T17:04:30+00:00", "url": "https://t.me/geranium_chronicles/94881"}, {"id": "94882", "text": "Последствия утреннего удара Гераней в Киевской области. Сгорело 3 складских помещения.", "datetime": "2026-11-14T17:09:46+00:00", "url": "https://t.me/geranium_chronicles/94882"}, {"id": "94890", "text": "В Монреале на улицы вышли порядка 5 тысяч человек, требующих роста расходов на образование и его доступности для всех.Мирное поначалу мероприятие обернулось беспорядками: в стражей порядка полетели камни и бутылки, после чего силовики ответили слезоточивым газом и светошумовыми гранатами. Трое участников задержаны, также отмечены акты вандализма и порча имущества.🍿", "datetime": "2026-11-14T17:15:07+00:00", "url": "https://t.me/geranium_chronicles/94890"}, {"id": "94893", "text": "20:20 Лебедин Сумской области - взрыв💥Герань🚀", "datetime": "2026-11-14T17:30:08+00:00", "url": "https://t.me/geranium_chronicles/94893"}, {"id": "94894", "text": "20:25 Оратов Винницкой области - взрыв💥Герань🚀", "datetime": "2026-11-14T17:30:48+00:00", "url": "https://t.me/geranium_chronicles/94894"}]}