{"channel": "geranium_chronicles", "title": "Хроники Гераней", "posts": [{"id": "89114", "text": "Киевский метрополитен.🤔", "datetime": "2026-10-08T18:20:18+00:00", "url": "https://t.me/geranium_chronicles/89114"}, {"id": "89115", "text": "21:20 Окрестности Сум - взрывы💥УМПК.", "datetime": "2026-10-08T18:21:41+00:00", "url": "https://t.me/geranium_chronicles/89115"}, {"id": "89116", "text": "21:25 Бровары Киевской области - взрыв💥Герань🚀", "datetime": "2026-10-08T18:30:06+00:00", "url": "https://t.me/geranium_chronicles/89116"}, {"id": "89117", "text": "Во Львовской области столкнулись 2 поезда🤔", "datetime": "2026-10-08T18:32:30+00:00", "url": "https://t.me/geranium_chronicles/89117"}, {"id": "89119", "text": "21:30 ПС 750 «Киевская» в Киевской области – взрыв💥Герань.", "datetime": "2026-10-08T18:33:34+00:00", "url": "https://t.me/geranium_chronicles/89119"}, {"id": "89120", "text": "21:45 Запорожская область - взрывы💥УМПК.", "datetime": "2026-10-08T18:47:42+00:00", "url": "https://t.me/geranium_chronicles/89120"}, {"id": "89121", "text": "21:50 Боярка Киевской области - взрыв💥Герань🚀", "datetime": "2026-10-08T18:55:45+00:00", "url": "https://t.me/geranium_chronicles/89121"}, {"id": "89122", "text": "Всем хорошего вечера четверга!😇", "datetime": "2026-10-08T19:03:28+00:00", "url": "https://t.me/geranium_chronicles/89122"}, {"id": "89123", "text": "22:02 Кривой Рог - взрыв💥Дань-Т.", "datetime": "2026-10-08T19:07:27+00:00", "url": "https://t.me/geranium_chronicles/89123"}, {"id": "89124", "text": "Идеальный план. Надёжный как швейцарские часы: \"Засрать Днепр\"©🍿", "datetime": "2026-10-08T19:49:50+00:00", "url": "https://t.me/geranium_chronicles/89124"}, {"id": "89125", "text": "Всем Доброго утречка пятницы!😇", "datetime": "2026-10-09T02:21:49+00:00", "url": "https://t.me/geranium_chronicles/89125"}, {"id": "89126", "text": "Ночью Герани🚀посетили Западную Украину. Под ударами были Ивано-Франковск, Луцк, Ягодин Волынской области и несколько ударов было в Ровенской области.На фото и видео Ивано-Франковск.", "datetime": "2026-10-09T02:26:24+00:00", "url": "https://t.me/geranium_chronicles/89126"}, {"id": "89130", "text": "Ещё видео из Ивано-Франковска🤔", "datetime": "2026-10-09T02:33:28+00:00", "url": "https://t.me/geranium_chronicles/89130"}]}